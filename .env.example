# Copy to .env on the VPS only. NEVER commit the real .env to git.
# All scripts read credentials from environment variables — never hardcode them.

KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional, if/when added:
PERPLEXITY_API_KEY=

# Which broker to trade through: indstocks | kite
BROKER=indstocks

# INDstocks — token expires every 24h, normally supplied via Telegram `token <value>`
INDSTOCKS_ACCESS_TOKEN=

# INDstocks TOTP auto-login (scripts/indstocks_auth.py --auto) — lets cron generate a
# fresh token every morning with no human involved. INDSTOCKS_TOTP_SECRET is the base32
# "manual entry key" shown next to the QR code when enabling TOTP (NOT the 6-digit code
# your app displays — that changes every 30s and can't be stored). INDSTOCKS_MPIN is your
# account MPIN. Both are as sensitive as a trading password — this file must stay
# chmod 600, root-owned, and is never included in any deployment zip.
INDSTOCKS_CLIENT_ID=
INDSTOCKS_TOTP_SECRET=
INDSTOCKS_MPIN=

# Read-only dashboard API (api/app.py — see docs/API.md). DASHBOARD_API_TOKEN
# is the single bearer secret every protected endpoint requires; unset means
# every protected request is refused (fail closed), never "auth disabled".
# DASHBOARD_CORS_ORIGINS is a comma-separated allow-list of origins the
# frontend is served from, e.g. http://localhost:5173,https://tradingbot.bhardwajvaibhav.com
DASHBOARD_API_TOKEN=
DASHBOARD_CORS_ORIGINS=
DASHBOARD_API_HOST=127.0.0.1
DASHBOARD_API_PORT=8787
