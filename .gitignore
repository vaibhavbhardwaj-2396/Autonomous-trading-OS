.env
*.key
*.pem
__pycache__/
*.pyc
node_modules/
venv/
.venv/
venv_broken_*/
venv_py312_check/
.DS_Store

# Stray local artifacts from this session's own debugging — never real
# project files. Left in place (not deleted — rm is unavailable here) but
# excluded from every future commit rather than accidentally included.
api/control.py.superseded
paper/paper_shadow.db.TEST_POLLUTION_delete_me
memory/.hmm_model.pkl
memory/.kite_session.json
logs/

# Research store — rebuildable from sources, never committed
research/*.db
research/*.db-wal
research/*.db-shm

# Research process run-logs and the continuous worker's runtime bookmarks /
# lock — operational artifacts written on the VPS, never versioned code
# (same class as the .db files above).
research/*_runs.jsonl
research/ai_failures.jsonl
research/.worker.lock
research/.worker_state.json
research/.worker_state.json.tmp
research/validation_campaign.jsonl
research/.validation_campaign.lock

# Global runtime control state (control/runtime.py, Priority Phase 4) —
# per-deployment operational state, same class as the research bookmarks
# above, never versioned code.
control/runtime_mode.json
control/runtime_mode.json.tmp
control/.runtime.lock

# AI budget state (control/ai_budget.py, outcome 2) — same class as the
# control state above.
control/ai_budget_state.json
control/ai_budget_state.json.tmp
control/.ai_budget.lock

# AI provider/model configuration (control/ai_config.py, outcome 2) —
# per-deployment operational state, same class as the above.
control/ai_config.json
control/ai_config.json.tmp
control/.ai_config.lock
control/notification_config.json
control/notification_config.json.tmp
control/notification_audit.jsonl
control/.notification_config.lock
control/component_state.json
control/component_state.json.tmp
control/.component_state.lock
control/watchdog_state.json
control/watchdog_state.json.tmp

# Paper/shadow store and its overlap-prevention lock (STABLE + CONTROLLED,
# outcome 1) — same class as research/*.db above: rebuildable simulation
# state, never committed. This gap (paper/*.db was never gitignored at
# all) was found the hard way — a test bug briefly bypassed its intended
# lock isolation and created a real paper_shadow.db with one synthetic
# test cycle (zero trades/orders — paper trading has no external side
# effects, but the file still should never have been trackable).
paper/*.db
paper/*.db-wal
paper/*.db-shm
paper/.paper.lock

# Recorder's overlap-prevention lock (same STABLE + CONTROLLED addition).
research/.recorder.lock

# Dashboard frontend config — per-deployment API base URL/token, never
# committed (same convention as .env). Copy frontend/config.example.js.
frontend/config.js

# Dashboard API's own minimal secrets file (deploy/api.env.example is the
# committed template; the real file is per-VPS, never committed).
deploy/api.env
deploy/notifications.env

# Live capital state, trade/regime history, and broker session files —
# exactly the list INSTALL.md already documents as "never overwritten by a
# deploy" (live state is per-installation, not versioned code). Templates
# and config-like files (memory/state.json.template, memory/mission.md,
# memory/guardrails.md, memory/strategy.md, memory/review_process.md) are
# NOT in this list — those are meant to ship with the repo.
memory/state.json
memory/trades.jsonl
memory/regime_log.jsonl
memory/trade_log.md
memory/research_log.md
memory/portfolio_state.md
memory/.indstocks_session.json
memory/.instruments.json
