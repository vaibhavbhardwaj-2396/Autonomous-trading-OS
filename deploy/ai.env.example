# deploy/ai.env.example — copy to deploy/ai.env on the VPS and install as
# root:tradingapi mode 640. Keep only AI-provider credentials/endpoints here.
# Never add broker, dashboard, Telegram, TOTP or MPIN secrets to this file.

# Official OpenAI Responses API.
OPENAI_API_KEY=

# Official Anthropic Messages API.
ANTHROPIC_API_KEY=

# Optional OpenAI-compatible remote provider.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Optional loopback-only OpenAI-compatible provider.
LOCAL_AI_BASE_URL=
