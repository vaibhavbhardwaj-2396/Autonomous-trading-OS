# deploy/api.env.example — copy to deploy/api.env on the VPS (chmod 600,
# owned by the tradingapi user — see docs/DEPLOYMENT.md step 12). This is a
# DELIBERATELY SEPARATE, minimal env file from the main .env at the repo
# root: trading-api.service's EnvironmentFile= points here, not at .env, so
# the read-only API process never has KITE_API_SECRET / INDSTOCKS_MPIN /
# TELEGRAM_BOT_TOKEN / etc. in its environment at all — it doesn't need any
# of them, and a bug in this API can't leak what it was never given.
#
# NEVER commit the real deploy/api.env to git (deploy/api.env is gitignored,
# same convention as the root .env — see .gitignore).

# The single bearer secret every protected dashboard endpoint requires (see
# docs/API.md "Authentication"). Generate one, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_API_TOKEN=

# Comma-separated origin allow-list for CORS. For the production Netlify
# deploy this is the dashboard's own origin, e.g.:
#   https://your-dashboard-site.netlify.app
# Add more origins (comma-separated) once a custom domain is attached.
DASHBOARD_CORS_ORIGINS=

# gunicorn binds 127.0.0.1:$DASHBOARD_API_PORT (see
# deploy/trading-api.service and deploy/Caddyfile.tradingbotapi — all three
# must agree on this port). DASHBOARD_API_HOST is read by api/config.py only
# when running via `python -m api.app` directly (local dev) — gunicorn's own
# --bind flag is what actually controls the bind address in production, so
# it is listed here for completeness/consistency but DASHBOARD_API_PORT is
# the one value that must be kept in sync with the systemd unit and Caddy.
DASHBOARD_API_HOST=127.0.0.1
DASHBOARD_API_PORT=8787

# --- Broker truth (see api/broker_truth.py, docs/BROKER_TRUTH.md) -----------
# The dashboard's /account endpoint labels every account figure with the
# ACTIVE broker and only shows broker-account numbers (total_value,
# broker_free_cash) when there is a fresh successful sync behind them.
#
# BROKER: the active broker id. MUST match BROKER in the main .env
# (engine/broker.py). Not a secret — just a label so the dashboard says
# "INDmoney / INDstocks" from config instead of defaulting to it. If unset,
# the dashboard assumes `indstocks` (the same default engine/broker.py uses).
BROKER=indstocks
#
# DASHBOARD_BROKER_SNAPSHOT_MAX_AGE_HOURS: a broker_snapshot in
# memory/state.json older than this is reported as "stale" and its account
# figures are withheld. Default 24 (INDstocks tokens live 24h, so a healthy
# sync is always fresher than this).
DASHBOARD_BROKER_SNAPSHOT_MAX_AGE_HOURS=24
#
# DASHBOARD_BROKER_CUTOVER: optional ISO-8601 timestamp. Any broker_snapshot
# synced at or before it is treated as pre-migration Kite-era data and
# always reported "stale", regardless of age. Set this to the moment the
# INDstocks switch went live to guarantee no Kite-era snapshot is ever shown
# as current INDmoney truth. Example:
# DASHBOARD_BROKER_CUTOVER=2026-09-07T00:00:00+05:30
DASHBOARD_BROKER_CUTOVER=
#
# DASHBOARD_HOLDINGS_VALUE_FLOOR: if broker holdings are present but the
# account total minus free cash is at or below this many rupees, the holdings
# were not priced -> the account total is cash-only and is withheld
# ("Unavailable" on the dashboard) rather than shown. Default 1.0.
DASHBOARD_HOLDINGS_VALUE_FLOOR=1
